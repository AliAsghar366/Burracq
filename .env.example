# Copy this file to `.env` (git-ignored) and fill in your values,
# or set the same variables in the Netlify dashboard.

# --- PayPal: public client ID ---------------------------------
# Used by the PayPal JS SDK in the browser. Safe to expose.
VITE_PAYPAL_CLIENT_ID=your_paypal_client_id
VITE_PAYPAL_ENV=live

# --- PayPal: server-side credentials --------------------------
# Used by the Netlify Functions ONLY (never sent to the browser).
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_secret
PAYPAL_ENV=live
